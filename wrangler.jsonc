{
  "name": "pixel-auction-defense",
  "main": "dist/worker.mjs",
  "compatibility_date": "2025-10-01",
  "workers_dev": false,
  "build": {"command": "python3 tools/build.py"},
  "routes": [{"pattern":"pixel-auction.aldol.app","custom_domain":true}],
  "durable_objects": {"bindings":[{"name":"ROOMS","class_name":"AuctionRoom"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["AuctionRoom"]}]
}
